# API Keys
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx

# OmniRoute (Multi-provider LLM routing)
OMNIROUTE_BASE_URL=http://localhost:20128
OMNIROUTE_API_KEY=your-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=sqlite:./jarvis.db

# Voice (for later phases)
ELEVENLABS_API_KEY=your-key
VOICE_PROVIDER=elevenlabs
VOICE_MODEL=en_US-neural2

# Router mode (test-only; leave ALL of these unset for the real agent)
# Mock routers return scripted planner actions and do NOT call an LLM.
# They are refused entirely when NODE_ENV=production.
#   USE_MOCK_ROUTER=true          fast deterministic mock
#   USE_SLOW_MOCK_ROUTER=true     5s planner delays, for cancellation/UI testing
#   USE_FAILING_MOCK_ROUTER=true  deterministic planner fault, for FAILED-state testing

# Agent Configuration
MAX_AGENT_STEPS=20
AGENT_TIMEOUT=300000
DEBUG=false

# Gmail capability (Checkpoint 17) — see GMAIL_SETUP.md for exact
# Google Cloud Console steps to obtain these. Never commit real values.
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback
# Deterministic local mailbox fixture, no real credentials/network needed.
# Refused automatically when NODE_ENV=production, same as USE_MOCK_ROUTER.
USE_MOCK_GMAIL=false

# Calendar capability (Checkpoint 18) — reuses the SAME GMAIL_CLIENT_ID/
# GMAIL_CLIENT_SECRET/GMAIL_REDIRECT_URI above (incremental OAuth consent,
# no separate client). See CALENDAR_SETUP.md.
# Overrides the machine's own local timezone if set; otherwise JARVIS uses
# Intl.DateTimeFormat().resolvedOptions().timeZone automatically.
CALENDAR_TIMEZONE=
# Deterministic local fixture calendar, no real credentials/network needed.
# Refused automatically when NODE_ENV=production, same as USE_MOCK_GMAIL.
USE_MOCK_CALENDAR=false

# Contacts read-only resolution (Checkpoint 19) — reuses the SAME
# GMAIL_CLIENT_ID/GMAIL_CLIENT_SECRET/GMAIL_REDIRECT_URI above (incremental
# OAuth consent, no separate client, no separate token file). See
# CONTACTS_SETUP.md. Read-only — no write/create/update/delete capability
# exists for Contacts at all.
# Deterministic local fixture address book, no real credentials/network
# needed. Refused automatically when NODE_ENV=production, same as
# USE_MOCK_GMAIL/USE_MOCK_CALENDAR.
USE_MOCK_CONTACTS=false

# Tasks capability (Checkpoint 20) — reuses the SAME GMAIL_CLIENT_ID/
# GMAIL_CLIENT_SECRET/GMAIL_REDIRECT_URI above (incremental OAuth consent,
# no separate client, no separate token file). See TASKS_SETUP.md.
# Deterministic local fixture task list, no real credentials/network
# needed. Refused automatically when NODE_ENV=production, same as
# USE_MOCK_GMAIL/USE_MOCK_CALENDAR/USE_MOCK_CONTACTS.
USE_MOCK_TASKS=false
